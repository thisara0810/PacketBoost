[Unit]
Description=PacketBoost KCP Acceleration Server Daemon
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/kcptun/kcptun-server -c /etc/kcptun/server.json
Restart=always
RestartSec=3s
LimitNOFILE=65535
LimitNPROC=65535
MemoryHigh=512M
MemoryMax=1G

[Install]
WantedBy=multi-user.target
